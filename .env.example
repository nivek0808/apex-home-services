# Application Settings
DEBUG=false
APP_NAME=Apex Home Services

# Google AI Studio API (Primary LLM)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GOOGLE_AI_MODEL_PRIMARY=gemini-3.5-flash-lite
GOOGLE_AI_MODEL_FALLBACK=gemma-4-31b-it
GOOGLE_AI_TEMPERATURE=0.3
GOOGLE_AI_MAX_TOKENS=4096

# Legacy Local LLM (fallback)
LOCAL_LLM_URL=http://localhost:8080/v1

# Invoice Ninja
INVOICE_NINJA_TOKEN=your_invoice_ninja_token_here
INVOICE_NINJA_URL=http://localhost:8003

# Cal.com
CALCOM_API_URL=http://localhost:3000/api/v1

# Database
DATABASE_URL=sqlite:///./apex_sandbox.db
